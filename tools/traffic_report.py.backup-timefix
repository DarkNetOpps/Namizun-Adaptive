#!/usr/bin/env python3

from pathlib import Path
from datetime import datetime
import subprocess
import json


PROJECT = Path("/var/www/namizun")
LOG = PROJECT / "namizun.log"
STATE = PROJECT / "tools/traffic_report_state.json"


def get_network():
    cmd = (
        "cd /var/www/namizun && "
        "/var/www/namizun/venv/bin/python3 -c "
        "\"from namizun_core.network import get_network_io; "
        "u,d=get_network_io(); print(u); print(d)\""
    )

    out = subprocess.check_output(cmd, shell=True).decode().splitlines()
    return int(out[0]), int(out[1])


def gib(x):
    return x / 1024 / 1024 / 1024


def get_last_lines(pattern, count=5):
    if not LOG.exists():
        return []

    lines = LOG.read_text(errors="ignore").splitlines()
    return [x for x in lines if pattern in x][-count:]


def get_service():
    try:
        return subprocess.check_output(
            "systemctl is-active namizun",
            shell=True
        ).decode().strip()
    except:
        return "unknown"


def load_state():
    if STATE.exists():
        try:
            return json.loads(STATE.read_text())
        except:
            pass

    return None


def save_state(upload, download):
    STATE.write_text(json.dumps({
        "upload": upload,
        "download": download,
        "time": datetime.now().isoformat()
    }))


def main():

    upload, download = get_network()

    old = load_state()

    print("=" * 55)
    print("          Namizun Traffic Report")
    print("=" * 55)

    print()
    print("Time:", datetime.now().strftime("%Y-%m-%d %H:%M:%S"))

    print()
    print("Network:")
    print(f" Upload:   {gib(upload):.3f} GiB")
    print(f" Download: {gib(download):.3f} GiB")

    ratio = upload / download if download else 0
    print(f" Ratio:    {ratio:.5f}")
    missing = (download * 10) - upload
    print(f" Missing upload to 10x: {max(0, missing)/1024/1024/1024:.3f} GiB")

    if old:
        du = upload - old["upload"]
        dd = download - old["download"]

        old_ratio = old["upload"] / old["download"] if old["download"] else 0

        print()
        print("Since last report:")
        print(f" Upload delta:   +{gib(du):.3f} GiB")
        print(f" Download delta: +{gib(dd):.3f} GiB")
        print(f" Ratio change:   {old_ratio:.5f} -> {ratio:.5f}")

        elapsed = (datetime.now() - old["time"]).total_seconds()

        if elapsed > 0:
            upload_speed = du / elapsed
            download_speed = dd / elapsed

            print()
            print("Performance:")

            print(f" Upload speed:   {upload_speed/1024/1024:.3f} MB/s")
            print(f" Download speed: {download_speed/1024/1024:.3f} MB/s")

            if dd > 0:
                print(f" Recovery power: {du/dd:.2f}x")

    else:
        print()
        print("Since last report:")
        print(" First run - no previous data")

    save_state(upload, download)

    print()
    print("Last upload loops:")
    for x in get_last_lines("new upload loop started"):
        print(x)

    print()
    print("Last UDP uploads:")
    for x in get_last_lines("udp uploader"):
        print(x)

    print()
    print("Service:")
    print(" namizun:", get_service())

    print("=" * 55)


if __name__ == "__main__":
    main()
